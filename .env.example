APP_NAME=pulse-api
APP_VERSION=0.1.0
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PULSE_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PULSE_API_BASE_URL=http://localhost:4000

# Use a local Postgres role that can create the pg-boss schema.
DATABASE_URL=postgresql://your-local-db-user@localhost:5432/pulse_platform_dev
PG_BOSS_CONNECTION_STRING=postgresql://your-local-db-user@localhost:5432/pulse_platform_dev
PGBOSS_SCHEMA=pgboss
PGBOSS_ARCHIVE_SECONDS=604800
PGBOSS_DELETE_AFTER_SECONDS=2592000
PGBOSS_MONITOR_INTERVAL_SECONDS=5
PGBOSS_POLLING_INTERVAL_SECONDS=2
PGBOSS_DEAD_LETTER_QUEUE=pulse.dead-letter

ACUMATICA_BASE_URL=https://example.acumatica.local
ACUMATICA_API_VERSION=24.100.001
ACUMATICA_COMPANY=Dynamic AQS
ACUMATICA_USERNAME=svc-pulse
ACUMATICA_PASSWORD=replace-me
ACUMATICA_ACCESS_TOKEN=
MIGRATION_ADMIN_TOKEN=replace-with-strong-admin-token

AUTH_ISSUER=pulse.local
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_PASSWORD_RECOVERY_TOKEN_TTL_MINUTES=60
AUTH_PASSWORD_RECOVERY_PREVIEW_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@pulse.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-me
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Pulse Bootstrap Admin
AUTH_BOOTSTRAP_ADMIN_ROLE=SUPER_ADMIN

# Outlook / Microsoft Graph dev integration
APP_ENCRYPTION_KEY=replace-with-strong-random-secret
MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_LOGIN_REDIRECT_URI=http://localhost:3000/auth/entra/callback
MICROSOFT_ENTRA_LOGIN_SCOPES=openid profile email offline_access User.Read
MICROSOFT_ENTRA_GROUP_ROLE_MAP=
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/outlook/callback
MICROSOFT_GRAPH_SCOPES=openid profile email offline_access User.Read Calendars.ReadWrite
MICROSOFT_ENTRA_AUTH_BASE_URL=https://login.microsoftonline.com
MICROSOFT_GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
