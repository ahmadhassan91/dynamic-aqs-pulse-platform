aws_region     = "us-east-1"
aws_account_id = "622221238806"
project_name   = "pulse"
environment    = "staging"

# Add the deployed CRM/API origins before enabling direct browser uploads.
allowed_cors_origins = [
  "http://localhost:3000"
]

# Optional custom domain. ACM certificates for CloudFront must be in us-east-1.
asset_domain_name          = ""
cloudfront_certificate_arn = ""

# Optional CloudFront access logs. The value must be an S3 bucket domain name,
# for example "my-log-bucket.s3.amazonaws.com".
enable_cloudfront_logging = false
cloudfront_log_bucket_name = ""
