{
  "name": "dynamic-aqs-pulse-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf .turbo",
    "db:generate": "node ./scripts/run-with-env.mjs pnpm --filter @pulse/db generate",
    "db:migrate": "node ./scripts/run-with-env.mjs pnpm --filter @pulse/db migrate:dev",
    "dev:api": "node ./scripts/run-with-env.mjs pnpm --filter @pulse/contracts build && node ./scripts/run-with-env.mjs pnpm --filter @pulse/db build && node ./scripts/run-with-env.mjs pnpm --filter @pulse/api build && node ./scripts/run-with-env.mjs pnpm --filter @pulse/api start",
    "dev:web": "node ./scripts/run-with-env.mjs pnpm --filter @pulse/crm-web exec next dev --port 3000",
    "bootstrap:local": "./scripts/bootstrap-local.sh",
    "start:local": "./scripts/start-local.sh"
  },
  "devDependencies": {
    "eslint-module-utils": "2.12.1",
    "turbo": "^2.0.14",
    "typescript": "^5.8.3"
  }
}
