model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  displayName     String
  roleCode        String
  userType        UserKind @default(INTERNAL)
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  identities                  UserIdentity[]
  sessions                    Session[]
  auditEntries                AuditEntry[] @relation("AuditActor")
  assignedSegmentAssignments   AccountSegmentAssignment[]
  classificationExceptionsOpened   ClassificationException[] @relation("ClassificationExceptionOpenedBy")
  classificationExceptionsResolved ClassificationException[] @relation("ClassificationExceptionResolvedBy")
  migrationRunsStarted        MigrationRun[] @relation("MigrationRunStartedBy")
  leadStageEvents             LeadStageEvent[] @relation("LeadStageEventActor")
  cisInternalReviewsStarted   CisInternalReview[] @relation("CisInternalReviewStartedBy")
  cisInternalReviewsSignedOff CisInternalReview[] @relation("CisInternalReviewSignedOffBy")
  cisFinanceDecisionsSubmitted CisFinanceDecision[] @relation("CisFinanceDecisionSubmittedBy")
  cisFinanceDecisionsDecided  CisFinanceDecision[] @relation("CisFinanceDecisionDecidedBy")
  onboardingChecklistItemOwners OnboardingChecklistItem[] @relation("OnboardingChecklistItemOwner")
  onboardingChecklistItemCompleted OnboardingChecklistItem[] @relation("OnboardingChecklistItemCompletedBy")
  leadConversionPreparationsReviewed LeadConversionPreparation[] @relation("LeadConversionPreparationReviewedBy")
  directedRegions            Region[] @relation("RegionDirector")
  managedTerritories         Territory[] @relation("TerritoryManager")
  assignedTmLeads            Lead[] @relation("LeadAssignedTm")
  assignedRdLeads            Lead[] @relation("LeadAssignedRd")
  assignedTmAccounts         Account[] @relation("AccountAssignedTm")
  assignedRdAccounts         Account[] @relation("AccountAssignedRd")
  territoryOverridesCreated  TerritoryAssignmentOverride[] @relation("TerritoryAssignmentOverrideCreatedBy")
  territoryOverridesAssignedTm TerritoryAssignmentOverride[] @relation("TerritoryAssignmentOverrideAssignedTm")
  territoryOverridesAssignedRd TerritoryAssignmentOverride[] @relation("TerritoryAssignmentOverrideAssignedRd")
  territoryAssignmentsChanged TerritoryAssignmentHistory[] @relation("TerritoryAssignmentHistoryChangedBy")
  websiteLeadSubmissionsReviewed WebsiteLeadSubmission[] @relation("WebsiteLeadSubmissionReviewedBy")
  leadImportRunsCreated       LeadImportRun[] @relation("LeadImportRunCreatedBy")
  groupRosterImportRunsCreated GroupRosterImportRun[] @relation("GroupRosterImportRunCreatedBy")
  dealerPortalMembership      DealerPortalUser?
  dealerPortalUsersCreated    DealerPortalUser[] @relation("DealerPortalUserCreatedBy")
  trainingTrainerProfile      TrainingTrainerProfile?
  trainingProgramsCreated     AccountTrainingProgram[] @relation("TrainingProgramCreatedBy")
  trainingProgramsOwnedTm     AccountTrainingProgram[] @relation("TrainingProgramOwnerTm")
  trainingProgramsOwnedRd     AccountTrainingProgram[] @relation("TrainingProgramOwnerRd")
  trainingSessionsDelivered   TrainingSession[] @relation("TrainingSessionTrainer")
  trainingCertificationsAwarded TrainingCertificationRecord[] @relation("TrainingCertificationAwardedBy")
  trainingFollowUpTasksOwned  TrainingFollowUpTask[] @relation("TrainingFollowUpTaskOwner")
  trainingFollowUpTasksCreated TrainingFollowUpTask[] @relation("TrainingFollowUpTaskCreatedBy")
  trainingProofDocumentsUploaded TrainingProofDocument[] @relation("TrainingProofDocumentUploadedBy")
  calendarConnections         CalendarConnection[]
  calendarAuthStates          CalendarConnectionAuthState[]
  passwordResetTokens         PasswordResetToken[]
  leadOperationalAlerts       LeadOperationalAlert[]        @relation("LeadOperationalAlertRecipientUser")

  @@index([roleCode])
  @@index([userType])
  @@index([isActive])
}

model ShippingCenter {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique
  name             String
  city             String?
  state            String?
  countryCode      String    @default("US")
  isActive         Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  territories      Territory[]
  assignedLeads    Lead[]    @relation("LeadShippingCenter")
  assignedAccounts Account[] @relation("AccountShippingCenter")

  @@index([isActive])
  @@index([state])
}

model TerritoryPolicy {
  id                               String   @id @default("default")
  preHandoffTmVisibility           Boolean  @default(false)
  assignNationalTmLeadsByDefault   Boolean  @default(true)
  strategicGrowthRetainsOwnership  Boolean  @default(true)
  notes                            String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}

model Region {
  id               String      @id @default(uuid()) @db.Uuid
  code             String      @unique
  name             String
  directorUserId   String?     @db.Uuid
  isActive         Boolean     @default(true)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  directorUser     User?       @relation("RegionDirector", fields: [directorUserId], references: [id], onDelete: SetNull)
  territories      Territory[]

  @@index([directorUserId])
  @@index([isActive])
}

model Territory {
  id               String                       @id @default(uuid()) @db.Uuid
  code             String                       @unique
  name             String
  regionId         String                       @db.Uuid
  managerUserId    String?                      @db.Uuid
  shippingCenterId String?                      @db.Uuid
  isActive         Boolean                      @default(true)
  notes            String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  region           Region                       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  managerUser      User?                        @relation("TerritoryManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  shippingCenter   ShippingCenter?              @relation(fields: [shippingCenterId], references: [id], onDelete: SetNull)
  stateCoverage    TerritoryStateCoverage[]
  leads            Lead[]
  accounts         Account[]
  assignmentOverrides TerritoryAssignmentOverride[]

  @@index([regionId])
  @@index([managerUserId])
  @@index([shippingCenterId])
  @@index([isActive])
}

model TerritoryStateCoverage {
  id               String    @id @default(uuid()) @db.Uuid
  territoryId      String    @db.Uuid
  stateCode        String
  countryCode      String    @default("US")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  territory        Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([countryCode, stateCode])
  @@index([territoryId])
}

model TerritoryAssignmentOverride {
  id               String                       @id @default(uuid()) @db.Uuid
  entityType       TerritoryAssignmentEntityType
  entityId         String
  territoryId      String                       @db.Uuid
  assignedTmUserId String?                      @db.Uuid
  assignedRdUserId String?                      @db.Uuid
  reasonCode       String
  reasonNote       String?
  createdByUserId  String?                      @db.Uuid
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  territory        Territory                    @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  assignedTmUser   User?                        @relation("TerritoryAssignmentOverrideAssignedTm", fields: [assignedTmUserId], references: [id], onDelete: SetNull)
  assignedRdUser   User?                        @relation("TerritoryAssignmentOverrideAssignedRd", fields: [assignedRdUserId], references: [id], onDelete: SetNull)
  createdByUser    User?                        @relation("TerritoryAssignmentOverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId])
  @@index([territoryId])
  @@index([assignedTmUserId])
  @@index([assignedRdUserId])
  @@index([createdByUserId])
}

model TerritoryAssignmentHistory {
  id                      String                       @id @default(uuid()) @db.Uuid
  entityType              TerritoryAssignmentEntityType
  entityId                String
  assignmentMethod        TerritoryAssignmentMethod
  previousTerritoryId     String?                      @db.Uuid
  previousTerritoryCode   String?
  nextTerritoryId         String?                      @db.Uuid
  nextTerritoryCode       String?
  previousShippingCenterId String?                     @db.Uuid
  nextShippingCenterId    String?                      @db.Uuid
  previousAssignedTmUserId String?                     @db.Uuid
  nextAssignedTmUserId    String?                      @db.Uuid
  previousAssignedRdUserId String?                     @db.Uuid
  nextAssignedRdUserId    String?                      @db.Uuid
  changedByUserId         String?                      @db.Uuid
  reasonCode              String?
  reasonNote              String?
  metadata                Json?
  changedAt               DateTime                     @default(now())

  changedByUser           User?                        @relation("TerritoryAssignmentHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, changedAt])
  @@index([changedByUserId])
}

model UserIdentity {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @db.Uuid
  provider            IdentityProvider
  providerSubject     String
  loginEmail          String?
  passwordHash        String?
  isPrimary           Boolean          @default(false)
  lastAuthenticatedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@unique([provider, providerSubject])
  @@unique([provider, loginEmail])
  @@index([userId])
  @@index([provider])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  identityId       String   @db.Uuid
  accessTokenHash  String   @unique
  refreshTokenHash String   @unique
  authMethod       SessionAuthMethod
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime
  refreshExpiresAt DateTime
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  revokedReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity         UserIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([identityId])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
  @@index([revokedAt])
}

model AuthLoginState {
  id         String           @id @default(uuid()) @db.Uuid
  provider   IdentityProvider
  stateHash  String           @unique
  nextPath   String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([provider, expiresAt])
}

model PasswordResetToken {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @db.Uuid
  identityId         String       @db.Uuid
  tokenHash          String       @unique
  requestedEmail     String
  requestedIpAddress String?
  requestedUserAgent String?
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity           UserIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([identityId, expiresAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model CalendarConnection {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @db.Uuid
  provider              CalendarConnectionProvider
  providerSubject       String
  providerEmail         String?
  scope                 String
  targetCalendarId      String?
  targetCalendarName    String?
  meetingProviderPreference CalendarMeetingProviderPreference @default(NONE)
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessTokenExpiresAt  DateTime
  isActive              Boolean                    @default(true)
  lastSyncedAt          DateTime?
  lastSyncError         String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bindings              CalendarEventBinding[]

  @@unique([userId, provider])
  @@unique([provider, providerSubject])
  @@index([provider])
  @@index([providerEmail])
  @@index([isActive])
}

model CalendarConnectionAuthState {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @db.Uuid
  provider              CalendarConnectionProvider
  stateHash             String                     @unique
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime                   @default(now())

  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, expiresAt])
  @@index([expiresAt])
}

model CalendarEventBinding {
  id                    String                     @id @default(uuid()) @db.Uuid
  connectionId          String                     @db.Uuid
  provider              CalendarConnectionProvider
  sourceModule          String
  sourceRecordId        String
  eventType             String
  externalEventId       String
  externalWebLink       String?
  externalMeetingJoinUrl String?
  targetCalendarId      String?
  meetingProvider       CalendarMeetingProviderPreference @default(NONE)
  lastSyncedAt          DateTime                   @default(now())
  lastSyncError         String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  connection            CalendarConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, sourceModule, sourceRecordId, eventType])
  @@index([connectionId, lastSyncedAt])
  @@index([sourceModule, sourceRecordId, eventType])
}

model AuditEntry {
  id               String    @id @default(uuid()) @db.Uuid
  actorUserId      String?   @db.Uuid
  action           AuditAction
  entityType       String
  entityId         String?
  beforeData       Json?
  afterData        Json?
  metadata         Json?
  requestId        String?
  correlationId    String?
  sourceSystem     String?
  createdAt        DateTime  @default(now())

  actor            User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([entityType, createdAt])
  @@index([action])
  @@index([requestId])
  @@index([correlationId])
  @@index([createdAt])
}

model FeatureFlag {
  id               String           @id @default(uuid()) @db.Uuid
  key              String           @unique
  name             String
  description      String?
  state            FeatureFlagState  @default(OFF)
  rolloutPercent   Int              @default(0)
  enabledForJson   Json?
  disabledForJson  Json?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([state])
  @@index([rolloutPercent])
}

model ExternalReference {
  id               String                     @id @default(uuid()) @db.Uuid
  source           ExternalReferenceSource
  entityType       ExternalReferenceEntityType
  entityId         String
  externalId       String
  externalParentId String?
  externalKey      String?
  payload          Json?
  isPrimary        Boolean                    @default(false)
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([source, entityType, externalId])
  @@index([entityType, entityId])
  @@index([source, entityType])
  @@index([externalId])
}

model MigrationRun {
  id               String             @id @default(uuid()) @db.Uuid
  sourceSystem     DataSourceSystem
  wave             MigrationWave?
  mode             MigrationRunMode
  status           MigrationRunStatus @default(PENDING)
  startedByUserId  String?            @db.Uuid
  entityScope      Json?
  summary          Json?
  reconciliation   Json?
  notes            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  startedBy        User?              @relation("MigrationRunStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  sourceSnapshots  SourceRecordSnapshot[]
  records          MigrationRunRecord[]

  @@index([sourceSystem, mode])
